---
layout: default
---
{% comment %}
  ===========================================================================
  FORK NOTICE (i18n): This layout is forked from al_folio_cv gem's
  templates/cv/render.liquid (gem v1.0.2, ~18 lines using
  {% al_folio_cv_render %}) and extended with i18n support:
    - Per-language data lookup: site.data[site.active_lang].cv (lines ~43-46)
    - Per-language string labels (36 places, via site.data[active_lang].strings.cv)
    - '|||' sentinel handling for inline section separators (lines ~171/191)
  The gem's render.liquid does NOT support i18n, so we cannot revert to it yet.
  TODO(upstream): PR al_folio_cv to support per-lang data + string labels,
  then revert to the 18-line gem version.
  On every `bundle update al_folio_cv`, diff this file against the new
  gem templates/cv/render.liquid and merge non-i18n upstream changes.
  See verification-report.md cv-liquid-stale-fork / plan §2.4.
  ===========================================================================
  Unified CV layout that handles both RenderCV (YAML) and JSONResume (JSON) formats
  - If page.cv_format is set, it determines which format to render:
  - 'rendercv': Load and render only RenderCV data (site.data.cv.cv)
  - 'jsonresume': Load and render only JSONResume data (site.data.resume)
  - If page.cv_format is not set, the legacy behavior applies:
  - RenderCV data is in site.data.cv.cv
  - JSONResume data is in site.data.resume
  - RenderCV is prioritized if both exist
  Both formats use the same unified rendering includes for consistent output
{% endcomment %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
          class="float-right">
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      {% comment %} Determine which CV format to render {% endcomment %}
      {% comment %} First, try language-specific CV data (e.g., _data/zh_CN/cv.yml), fallback to root {% endcomment %}
      {% assign lang_cv_data = site.data[site.active_lang].cv %}
      {% assign root_cv_data = site.data.cv %}
      {% assign lang_resume_data = site.data[site.active_lang].resume %}
      {% assign root_resume_data = site.data.resume %}

      {% assign render_rendercv = false %}
      {% assign render_jsonresume = false %}
      {% assign cv = null %}

      {% if page.cv_format == 'rendercv' %}
        {% assign render_rendercv = true %}
      {% elsif page.cv_format == 'jsonresume' %}
        {% assign render_jsonresume = true %}
      {% else %}
        {% comment %} Check language-specific RenderCV first, then root, then JSONResume {% endcomment %}
        {% if lang_cv_data and lang_cv_data.cv %}
          {% assign render_rendercv = true %}
        {% elsif root_cv_data and root_cv_data.cv %}
          {% assign render_rendercv = true %}
        {% elsif lang_resume_data %}
          {% assign render_jsonresume = true %}
        {% elsif root_resume_data %}
          {% assign render_jsonresume = true %}
        {% endif %}
      {% endif %}

      {% if render_rendercv %}
        {% comment %} RenderCV format - use language-specific data if available {% endcomment %}
        {% if lang_cv_data and lang_cv_data.cv %}
          {% assign cv = lang_cv_data.cv %}
        {% else %}
          {% assign cv = root_cv_data.cv %}
        {% endif %}

        {% if cv %}
          <!-- Header/Contact Information -->
          {% if cv.name or cv.label or cv.location or cv.email or cv.phone or cv.website %}
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">
                {{ site.data[site.active_lang].strings.cv.contact_information | default: 'Contact Information' }}
              </h3>
              <table class="table table-cv table-sm table-borderless">
                {% if cv.name %}
                  <tr>
                    <td class="p-1 pr-2 font-weight-bold">
                      <b>{{ site.data[site.active_lang].strings.cv.name | default: 'Name' }}</b>
                    </td>
                    <td class="p-1 pl-2 font-weight-light">{{ cv.name }}</td>
                  </tr>
                {% endif %}
                {% if cv.label %}
                  <tr>
                    <td class="p-1 pr-2 font-weight-bold">
                      <b>{{ site.data[site.active_lang].strings.cv.professional_title | default: 'Professional Title' }}</b>
                    </td>
                    <td class="p-1 pl-2 font-weight-light">{{ cv.label }}</td>
                  </tr>
                {% endif %}
                {% if cv.email %}
                  <tr>
                    <td class="p-1 pr-2 font-weight-bold">
                      <b>{{ site.data[site.active_lang].strings.cv.email | default: 'Email' }}</b>
                    </td>
                    <td class="p-1 pl-2 font-weight-light">{{ cv.email }}</td>
                  </tr>
                {% endif %}
                {% if cv.phone %}
                  <tr>
                    <td class="p-1 pr-2 font-weight-bold">
                      <b>{{ site.data[site.active_lang].strings.cv.phone | default: 'Phone' }}</b>
                    </td>
                    <td class="p-1 pl-2 font-weight-light">{{ cv.phone }}</td>
                  </tr>
                {% endif %}
                {% if cv.address %}
                  <tr>
                    <td class="p-1 pr-2 font-weight-bold">
                      <b>{{ site.data[site.active_lang].strings.cv.location | default: 'Location' }}</b>
                    </td>
                    <td class="p-1 pl-2 font-weight-light">
                      {% if cv.address.street %}
                        {{ cv.address.street }},
                      {% endif %}
                      {% if cv.address.city %}
                        {{ cv.address.city }},
                      {% endif %}
                      {% if cv.address.region %}
                        {{ cv.address.region }}
                      {% endif %}
                      {% if cv.address.postalCode %}
                        {{ cv.address.postalCode -}}
                      {%- endif %}
                    </td>
                  </tr>
                {% endif %}
                {% if cv.website %}
                  <tr>
                    <td class="p-1 pr-2 font-weight-bold">
                      <b>{{ site.data[site.active_lang].strings.cv.website | default: 'Website' }}</b>
                    </td>
                    <td class="p-1 pl-2 font-weight-light">
                      <a href="{{ cv.website }}" target="_blank">{{ cv.website }}</a>
                    </td>
                  </tr>
                {% endif %}
              </table>
            </div>
          {% endif %}

          <!-- Summary -->
          {% if cv.summary %}
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">
                {{ site.data[site.active_lang].strings.cv.professional_summary | default: 'Professional Summary' }}
              </h3>
              <p>{{ cv.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
            </div>
          {% endif %}

          <!-- RenderCV Sections - Merge Experience and Volunteer -->
          {% comment %} Detect experience/volunteer sections by entry structure (language-agnostic) {% endcomment %}
          {% assign empty_array = '' | split: ',' %}
          {% assign combined_experience = empty_array %}
          {% assign experience_section_names = '' %}
          {% for section_pair in cv.sections %}
            {% assign s_first = section_pair[1] | first %}
            {% if s_first.company or s_first.organization %}
              {% assign combined_experience = combined_experience | concat: section_pair[1] %}
              {% assign experience_section_names = experience_section_names | append: '|||' | append: section_pair[0] | append: '|||' %}
            {% endif %}
          {% endfor %}
          {% if combined_experience.size > 0 %}
            <a class="anchor" id="experience"></a>
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">{{ site.data[site.active_lang].strings.cv.experience | default: 'Experience' }}</h3>
              <div>
                {% assign entries = combined_experience | al_cv_sort_by_date %}
                {% include cv/experience.liquid %}
              </div>
            </div>
          {% endif %}

          {% comment %} Now render all other sections except experience/volunteer {% endcomment %}
          {% for section_pair in cv.sections %}
            {% assign section_title = section_pair[0] %}
            {% assign section_entries = section_pair[1] %}

            {% comment %} Skip sections already processed as experience/volunteer {% endcomment %}
            {% assign check_name = '|||' | append: section_title | append: '|||' %}
            {% if experience_section_names contains check_name %}
              {% continue %}
            {% endif %}

            {% comment %} Detect section type by entry structure (language-agnostic) {% endcomment %}
            {% assign first_entry = section_entries | first %}
            {% assign section_type = 'generic' %}
            {% if first_entry.institution and first_entry.degree %}
              {% assign section_type = 'education' %}
            {% elsif first_entry.awarder %}
              {% assign section_type = 'awards' %}
            {% elsif first_entry.publisher %}
              {% assign section_type = 'publications' %}
            {% elsif first_entry.name and first_entry.level %}
              {% assign section_type = 'skills' %}
            {% elsif first_entry.language and first_entry.fluency %}
              {% assign section_type = 'languages' %}
            {% elsif first_entry.reference %}
              {% assign section_type = 'references' %}
            {% elsif first_entry.name and first_entry.keywords %}
              {% assign section_type = 'interests' %}
            {% elsif first_entry.name and first_entry.issuer %}
              {% assign section_type = 'certificates' %}
            {% elsif first_entry.name and first_entry.url and first_entry.description %}
              {% assign section_type = 'projects' %}
            {% endif %}

            <a class="anchor" id="{{ section_title | slugify }}"></a>
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">{{ section_title }}</h3>
              <div>
                {% if section_type == 'education' %}
                  {% assign entries = section_entries | al_cv_sort_by_date %}
                  {% include cv/education.liquid %}
                {% elsif section_type == 'awards' %}
                  {% assign entries = section_entries %}
                  {% include cv/awards.liquid %}
                {% elsif section_type == 'publications' %}
                  {% assign entries = section_entries %}
                  {% include cv/publications.liquid %}
                {% elsif section_type == 'skills' %}
                  {% assign entries = section_entries %}
                  {% include cv/skills.liquid %}
                {% elsif section_type == 'languages' %}
                  {% assign entries = section_entries %}
                  {% include cv/languages.liquid %}
                {% elsif section_type == 'interests' %}
                  {% assign entries = section_entries %}
                  {% include cv/interests.liquid %}
                {% elsif section_type == 'certificates' %}
                  {% assign entries = section_entries %}
                  {% include cv/certificates.liquid %}
                {% elsif section_type == 'projects' %}
                  {% assign entries = section_entries %}
                  {% include cv/projects.liquid %}
                {% elsif section_type == 'references' %}
                  {% assign entries = section_entries %}
                  {% include cv/references.liquid %}
                {% else %}
                  <!-- Generic section -->
                  {% for entry in section_entries %}
                    {% if entry.bullet %}
                      <ul class="card-text font-weight-light list-group list-group-flush">
                        <li class="list-group-item">{{ entry.bullet | markdownify | remove: '<p>' | remove: '</p>' }}</li>
                      </ul>
                    {% elsif entry.label %}
                      <div class="card-text font-weight-light">
                        <strong>{{ entry.label }}:</strong>
                        {{ entry.details }}
                      </div>
                    {% endif %}
                  {% endfor %}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% endif %}
      {% elsif render_jsonresume %}
        {% comment %} JSONResume format - use language-specific data if available {% endcomment %}
        {% if lang_resume_data %}
          {% assign resume = lang_resume_data %}
        {% else %}
          {% assign resume = root_resume_data %}
        {% endif %}

        {% if resume %}
          <!-- Contact Information -->
          {% if resume.basics %}
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">
                {{ site.data[site.active_lang].strings.cv.contact_information | default: 'Contact Information' }}
              </h3>
              {% assign basics = resume.basics %}
              <table class="table table-cv table-sm table-borderless">
                {% if basics.name %}
                  <tr>
                    <td class="p-1 pr-2 font-weight-bold">
                      <b>{{ site.data[site.active_lang].strings.cv.name | default: 'Name' }}</b>
                    </td>
                    <td class="p-1 pl-2 font-weight-light">{{ basics.name }}</td>
                  </tr>
                {% endif %}
                {% if basics.label %}
                  <tr>
                    <td class="p-1 pr-2 font-weight-bold">
                      <b>{{ site.data[site.active_lang].strings.cv.professional_title | default: 'Professional Title' }}</b>
                    </td>
                    <td class="p-1 pl-2 font-weight-light">{{ basics.label }}</td>
                  </tr>
                {% endif %}
                {% if basics.email %}
                  <tr>
                    <td class="p-1 pr-2 font-weight-bold">
                      <b>{{ site.data[site.active_lang].strings.cv.email | default: 'Email' }}</b>
                    </td>
                    <td class="p-1 pl-2 font-weight-light">{{ basics.email }}</td>
                  </tr>
                {% endif %}
                {% if basics.phone %}
                  <tr>
                    <td class="p-1 pr-2 font-weight-bold">
                      <b>{{ site.data[site.active_lang].strings.cv.phone | default: 'Phone' }}</b>
                    </td>
                    <td class="p-1 pl-2 font-weight-light">{{ basics.phone }}</td>
                  </tr>
                {% endif %}
                {% if basics.location %}
                  <tr>
                    <td class="p-1 pr-2 font-weight-bold">
                      <b>{{ site.data[site.active_lang].strings.cv.location | default: 'Location' }}</b>
                    </td>
                    <td class="p-1 pl-2 font-weight-light">
                      {% if basics.location.address %}
                        {{ basics.location.address }},
                      {% endif %}
                      {% if basics.location.city %}
                        {{ basics.location.city }},
                      {% endif %}
                      {% if basics.location.region %}
                        {{ basics.location.region }}
                      {% endif %}
                      {% if basics.location.postalCode %}
                        {{ basics.location.postalCode -}}
                      {%- endif %}
                    </td>
                  </tr>
                {% endif %}
                {% if basics.url %}
                  <tr>
                    <td class="p-1 pr-2 font-weight-bold">
                      <b>{{ site.data[site.active_lang].strings.cv.website | default: 'Website' }}</b>
                    </td>
                    <td class="p-1 pl-2 font-weight-light">
                      <a href="{{ basics.url }}" target="_blank">{{ basics.url }}</a>
                    </td>
                  </tr>
                {% endif %}
              </table>
            </div>
          {% endif %}

          <!-- Summary -->
          {% if resume.basics.summary %}
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">
                {{ site.data[site.active_lang].strings.cv.professional_summary | default: 'Professional Summary' }}
              </h3>
              <p>{{ resume.basics.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
            </div>
          {% endif %}

          <!-- JSONResume Sections - Merge work and volunteer into Experience -->
          {% assign empty_array = '' | split: ',' %}
          {% assign work = resume.work | default: empty_array %}
          {% assign vol = resume.volunteer | default: empty_array %}
          {% assign combined_experience = work | concat: vol | al_cv_sort_by_date %}
          {% if combined_experience.size > 0 %}
            <a class="anchor" id="experience"></a>
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">{{ site.data[site.active_lang].strings.cv.experience | default: 'Experience' }}</h3>
              <div>
                {% assign entries = combined_experience | al_cv_sort_by_date %}
                {% include cv/experience.liquid %}
              </div>
            </div>
          {% endif %}

          <!-- Education -->
          {% if resume.education.size > 0 %}
            <a class="anchor" id="education"></a>
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">{{ site.data[site.active_lang].strings.cv.education | default: 'Education' }}</h3>
              <div>
                {% assign entries = resume.education | al_cv_sort_by_date %}
                {% include cv/education.liquid %}
              </div>
            </div>
          {% endif %}

          <!-- Awards -->
          {% if resume.awards.size > 0 %}
            <a class="anchor" id="awards"></a>
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">{{ site.data[site.active_lang].strings.cv.awards | default: 'Awards' }}</h3>
              <div>
                {% assign entries = resume.awards %}
                {% include cv/awards.liquid %}
              </div>
            </div>
          {% endif %}

          <!-- Publications -->
          {% if resume.publications.size > 0 %}
            <a class="anchor" id="publications"></a>
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">{{ site.data[site.active_lang].strings.cv.publications | default: 'Publications' }}</h3>
              <div>
                {% assign entries = resume.publications %}
                {% include cv/publications.liquid %}
              </div>
            </div>
          {% endif %}

          <!-- Skills -->
          {% if resume.skills.size > 0 %}
            <a class="anchor" id="skills"></a>
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">{{ site.data[site.active_lang].strings.cv.skills | default: 'Skills' }}</h3>
              <div>
                {% assign entries = resume.skills %}
                {% include cv/skills.liquid %}
              </div>
            </div>
          {% endif %}

          <!-- Languages -->
          {% if resume.languages.size > 0 %}
            <a class="anchor" id="languages"></a>
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">{{ site.data[site.active_lang].strings.cv.languages | default: 'Languages' }}</h3>
              <div>
                {% assign entries = resume.languages %}
                {% include cv/languages.liquid %}
              </div>
            </div>
          {% endif %}

          <!-- Interests -->
          {% if resume.interests.size > 0 %}
            <a class="anchor" id="interests"></a>
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">{{ site.data[site.active_lang].strings.cv.interests | default: 'Interests' }}</h3>
              <div>
                {% assign entries = resume.interests %}
                {% include cv/interests.liquid %}
              </div>
            </div>
          {% endif %}

          <!-- Certificates -->
          {% if resume.certificates.size > 0 %}
            <a class="anchor" id="certificates"></a>
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">{{ site.data[site.active_lang].strings.cv.certificates | default: 'Certificates' }}</h3>
              <div>
                {% assign entries = resume.certificates %}
                {% include cv/certificates.liquid %}
              </div>
            </div>
          {% endif %}

          <!-- Projects -->
          {% if resume.projects.size > 0 %}
            <a class="anchor" id="projects"></a>
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">{{ site.data[site.active_lang].strings.cv.projects | default: 'Projects' }}</h3>
              <div>
                {% assign entries = resume.projects %}
                {% include cv/projects.liquid %}
              </div>
            </div>
          {% endif %}

          <!-- References -->
          {% if resume.references.size > 0 %}
            <a class="anchor" id="references"></a>
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">{{ site.data[site.active_lang].strings.cv.references | default: 'References' }}</h3>
              <div>
                {% assign entries = resume.references %}
                {% include cv/references.liquid %}
              </div>
            </div>
          {% endif %}
        {% endif %}
      {% else %}
        <p>
          {{
            site.data[site.active_lang].strings.cv.no_cv_found
            | default: 'No CV data found. Please configure RenderCV (cv.yml) or JSONResume (resume.json) data.'
          }}
        </p>
      {% endif %}
    </div>
  </article>
</div>
