---
layout: page
---
<div class="course">
  {% if page.instructor or page.term or page.location or page.time %}
    <div class="course-info">
      {% if page.instructor %}
        <p>
          <strong>{{ site.data[site.active_lang].strings.courses.instructor | default: 'Instructor' }}:</strong> {{ page.instructor }}
        </p>
      {% endif %}

      {% if page.term %}
        <p>
          <strong>{{ site.data[site.active_lang].strings.courses.term | default: 'Term' }}:</strong> {{ page.term }}
        </p>
      {% endif %}

      {% if page.location %}
        <p>
          <strong>{{ site.data[site.active_lang].strings.courses.location | default: 'Location' }}:</strong> {{ page.location }}
        </p>
      {% endif %}

      {% if page.time %}
        <p>
          <strong>{{ site.data[site.active_lang].strings.courses.time | default: 'Time' }}:</strong> {{ page.time }}
        </p>
      {% endif %}
    </div>
  {% endif %}

  {{ content }}

  {% if page.schedule %}
    <h2>{{ site.data[site.active_lang].strings.courses.schedule | default: 'Schedule' }}</h2>
    <table class="table table-sm table-responsive">
      <thead>
        <tr>
          <th>{{ site.data[site.active_lang].strings.courses.week | default: 'Week' }}</th>
          <th>{{ site.data[site.active_lang].strings.courses.date | default: 'Date' }}</th>
          <th>{{ site.data[site.active_lang].strings.courses.topic | default: 'Topic' }}</th>
          <th>{{ site.data[site.active_lang].strings.courses.materials | default: 'Materials' }}</th>
        </tr>
      </thead>
      <tbody>
        {% for entry in page.schedule %}
          <tr>
            <td>{{ entry.week }}</td>
            <td>{{ entry.date }}</td>
            <td>
              {% if entry.topic %}
                <strong>{{ entry.topic }}</strong>
              {% endif %}
              {% if entry.description %}
                <div class="schedule-description">{{ entry.description | markdownify }}</div>
              {% endif %}
            </td>
            <td>
              {% if entry.materials %}
                <ul class="schedule-materials">
                  {% for material in entry.materials %}
                    <li>
                      {% if material.url %}
                        {% if material.url contains '://' %}
                          <a href="{{ material.url }}" target="_blank">{{ material.name }}</a>
                        {% else %}
                          <a href="{{ material.url | relative_url }}" target="_blank">{{ material.name }}</a>
                        {% endif %}
                      {% else %}
                        {{ material.name }}
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
</div>
