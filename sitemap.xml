---
<?xml version="1.0" encoding="UTF-8"?>
{% comment %}
  Custom sitemap.xml (project root) replacing jekyll-sitemap's generated one.
  jekyll-sitemap skips auto-generation when sitemap.xml exists in the source
  (file_exists? checks pages + static_files for url == /sitemap.xml), so this
  Page is rendered once per polyglot language pass, into each language's dest.
  Each pass lists URLs with the active language prefix (default lang: none),
  matching the sitemap protocol rule that a sitemap's location constrains its URLs.
  page.static_files is not populated (jekyll-sitemap only injects it on its own
  generated page), so we filter site.static_files directly, mirroring the plugin's
  INCLUDED_EXTENSIONS (.htm .html .xhtml .pdf).
{% endcomment %}
{% assign lang_prefix = site.baseurl %}
{% unless site.active_lang == site.default_lang %}
  {% assign lang_prefix = lang_prefix | append: '/' | append: site.active_lang %}
{% endunless %}
{% assign site_origin = site.url %}
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign collections = site.collections | where_exp:'collection','collection.output != false' %}
  {% for collection in collections %}
    {% assign docs = collection.docs | where_exp:'doc','doc.sitemap != false' %}
    {% for doc in docs %}
      <url>
        <loc>{{ site_origin }}{{ lang_prefix }}{{ doc.url | replace:'/index.html','/' | xml_escape }}</loc>
        {% if doc.last_modified_at or doc.date %}
          <lastmod>{{ doc.last_modified_at | default: doc.date | date_to_xmlschema }}</lastmod>
        {% endif %}
      </url>
    {% endfor %}
  {% endfor %}

  {% assign pages = site.html_pages | where_exp:'doc','doc.sitemap != false' | where_exp:'doc','doc.url != "/404.html"' %}
  {% for page in pages %}
    <url>
      <loc>{{ site_origin }}{{ lang_prefix }}{{ page.url | replace:'/index.html','/' | xml_escape }}</loc>
      {% if page.last_modified_at %}
        <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
      {% endif %}
    </url>
  {% endfor %}

  {% assign static_files = site.static_files | where_exp:'file','file.sitemap != false' | where_exp:'file','file.name != "404.html"' | where_exp:'file','file.extname == ".htm" or file.extname == ".html" or file.extname == ".xhtml" or file.extname == ".pdf"' %}
  {% for file in static_files %}
    <url>
      <loc>{{ site_origin }}{{ lang_prefix }}{{ file.path | replace:'/index.html','/' | xml_escape }}</loc>
      <lastmod>{{ file.modified_time | date_to_xmlschema }}</lastmod>
    </url>
  {% endfor %}
</urlset>
