<!-- Metadata, OpenGraph and Schema.org -->
{% include metadata.liquid %}

<!-- Security: Content Security Policy -->
<!-- Hardened CSP with explicit script/style/font/connect allowlists. -->
<!-- Note: 'unsafe-inline' is currently retained for legacy inline scripts/event handlers. -->
<!-- To customize for your needs, see: https://developer.mozilla.org/en-US/docs/Web/HTTP/CSP -->
<meta
  http-equiv="Content-Security-Policy"
  content="default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self' https://app.loops.so; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://www.googletagmanager.com https://rum.cronitor.io https://api.pirsch.io https://openpanel.dev https://d1bxh8uas1mnw7.cloudfront.net https://badge.dimensions.ai https://giscus.app https://*.disqus.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com https://badge.dimensions.ai; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; media-src 'self'; frame-src 'self' https://giscus.app https://calendar.google.com https://*.disqus.com; connect-src 'self' https://giscus.app https://www.google-analytics.com https://region1.google-analytics.com https://rum.cronitor.io https://api.pirsch.io https://openpanel.dev https://badge.dimensions.ai https://metrics-api.dimensions.ai https://d1bxh8uas1mnw7.cloudfront.net https://*.disqus.com;">

<!-- Tailwind-first core styles -->
<link rel="stylesheet" href="{{ '/assets/css/tailwind.css' | relative_url | bust_file_cache }}">

<!--
  ============================================
  字体加载优化 (Font Loading Optimization)
  ============================================
-->

<!-- 预连接到 Google Fonts 服务器，减少 DNS 和 TCP 握手时间 -->
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<!--
  可选字体预加载（与 _config.yml 同步）:
  third_party_libraries:
    google_fonts:
      preload:
        - https://fonts.gstatic.com/...
-->
{% if site.third_party_libraries.google_fonts.preload %}
  <!-- 预加载关键字体文件，减少 FOIT (Flash of Invisible Text) -->
  {% for font_preload_url in site.third_party_libraries.google_fonts.preload %}
    <link rel="preload" as="font" type="font/woff2" href="{{ font_preload_url }}" crossorigin="anonymous">
  {% endfor %}
{% endif %}

<!-- Fonts & Icons -->
{% if site.plugins contains 'al_icons' %}
  {% include plugins/al_icons_styles.liquid %}
{% endif %}
<link
  defer
  rel="stylesheet"
  type="text/css"
  href="{{ site.third_party_libraries.google_fonts.url.fonts }}">

<!-- Code Syntax Highlighting -->
<link
  defer
  rel="stylesheet"
  href="{{ '/assets/css/jekyll-pygments-themes-github.css' | relative_url | bust_file_cache }}"
  media=""
  id="highlight_theme_light">

{% if page.toc and page.toc.sidebar %}
  <!-- Tocbot -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.tocbot.url.css }}"
    integrity="{{ site.third_party_libraries.tocbot.integrity.css }}"
    crossorigin="anonymous">
{% endif %}

<!-- Styles -->

{% if page.pseudocode %}
  <!-- pseudocode -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.pseudocode.url.css }}"
    integrity="{{ site.third_party_libraries.pseudocode.integrity.css }}"
    crossorigin="anonymous">
{% endif %}

{% if site.icon.size <= 4 %}
  <link
    rel="shortcut icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>">
{% elsif site.icon != blank %}
  <link rel="shortcut icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache}}">
{% endif %}
{% comment %}
  iOS home-screen bookmarks need rel="apple-touch-icon" pointing at a real raster image;
  Safari ignores the inline SVG data URI used for the emoji favicon and falls back to a
  screenshot of the page. Emitted only when a usable raster asset exists (v1 core 1.0.13 logic).
{% endcomment %}
{% if site.apple_touch_icon and site.apple_touch_icon != '' %}
  {% assign apple_touch_icon = site.apple_touch_icon %}
{% elsif site.icon and site.icon.size > 4 %}
  {% assign icon_extension = site.icon | split: '.' | last | split: '?' | first | downcase %}
  {% if icon_extension == 'png' or icon_extension == 'jpg' or icon_extension == 'jpeg' %}
    {% assign apple_touch_icon = site.icon %}
  {% endif %}
{% endif %}
{% if apple_touch_icon %}
  {% if apple_touch_icon contains '://' %}
    {% assign apple_touch_icon_url = apple_touch_icon %}
  {% elsif apple_touch_icon contains '/' %}
    {% assign apple_touch_icon_url = apple_touch_icon | relative_url | bust_file_cache %}
  {% else %}
    {% assign apple_touch_icon_url = apple_touch_icon | prepend: '/assets/img/' | relative_url | bust_file_cache %}
  {% endif %}
  <link rel="apple-touch-icon" href="{{ apple_touch_icon_url }}">
{% endif %}
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}">
{% comment %}
  canonical: canonical_url is computed in _includes/metadata.liquid (rendered first
  above); this tag emits it wrapped in static_href so polyglot's relativization of
  absolute hrefs does not rewrite it to the active language.
{% endcomment %}
<link rel="canonical" {% static_href %} href="{{ canonical_url | absolute_url }}" {% endstatic_href %}>
{% comment %} hreflang is emitted by _includes/metadata.liquid (BCP-47, real translations only, with x-default). {% endcomment %}

{% if page.noindex or page.sitemap == false %}
  <meta name="robots" content="noindex">
{% endif %}

<!-- Dark Mode -->
{% if site.enable_darkmode %}
  <script src="{{ '/assets/js/theme.js' | relative_url | bust_file_cache }}"></script>
  <link
    defer
    rel="stylesheet"
    href="{{ '/assets/css/jekyll-pygments-themes-native.css' | relative_url | bust_file_cache }}"
    media="none"
    id="highlight_theme_dark">
  <script>
    initTheme();
  </script>
{% endif %}

{% if page.map %}
  <!-- GeoJSON support via Leaflet -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.leaflet.url.css }}"
    integrity="{{ site.third_party_libraries.leaflet.integrity.css }}"
    crossorigin="anonymous">
{% endif %}

{% if page.code_diff %}
  <!-- diff2html -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.highlightjs.url.css.light }}"
    integrity="{{ site.third_party_libraries.highlightjs.integrity.css.light }}"
    crossorigin="anonymous"
    media="screen and (prefers-color-scheme: light)">
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.highlightjs.url.css.dark }}"
    integrity="{{ site.third_party_libraries.highlightjs.integrity.css.dark }}"
    crossorigin="anonymous"
    media="screen and (prefers-color-scheme: dark)">
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.diff2html.url.css }}"
    integrity="{{ site.third_party_libraries.diff2html.integrity.css }}"
    crossorigin="anonymous">
{% endif %}

{% if site.plugins contains 'al_img_tools' %}
  <!-- Image Features -->
  {% include plugins/al_img_tools_styles.liquid %}
{% endif %}

{% if site.plugins contains 'al_math' %}
  <!-- Math and Tikzjax -->
  {% include plugins/al_math_styles.liquid %}
{% endif %}

{% if site.enable_cookie_consent %}
  <!-- Cookie Consent -->
  {% include plugins/al_cookie_styles.liquid %}
{% endif %}
